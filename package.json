{
  "name": "stickyvik",
  "version": "0.2.0",
  "description": "Windows-first sticky Vikunja desktop companion.",
  "main": "dist-electron/main/main.js",
  "author": "khisanthax",
  "license": "MIT",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "clean": "rimraf dist dist-electron release",
    "dev": "concurrently -k \"npm:dev:main\" \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:main": "tsc -p tsconfig.node.json --watch --preserveWatchOutput",
    "dev:renderer": "vite",
    "dev:electron": "wait-on dist-electron/main/main.js tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.node.json",
    "build": "npm run clean && npm run typecheck && npm run build:renderer && npm run build:main",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.khisanthax.stickyvik",
    "productName": "Vikunja Sticky",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "dependencies": {
    "electron-store": "^10.1.0",
    "keytar": "^7.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "cross-env": "^10.0.0",
    "electron": "^36.0.0",
    "electron-builder": "^26.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "wait-on": "^8.0.0"
  }
}